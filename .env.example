# PostgreSQL durability. Without this, local development uses the in-memory store.
DATABASE_URL=postgresql://skillhydra:skillhydra@localhost:5432/skillhydra

# Auth boundary.
# dev: fixed local principal. trusted-header: require x-skillhydra-user-id from an authenticated upstream.
SKILLHYDRA_AUTH_MODE=dev
SKILLHYDRA_DEV_USER_ID=00000000-0000-4000-8000-000000000001
SKILLHYDRA_ALLOW_DEV_AUTH=false

# AI Gateway. If AI_GATEWAY_API_KEY/VERCEL_OIDC_TOKEN or AI_MODEL is absent, deterministic demo mode is used.
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
AI_MODEL=
AI_FALLBACK_MODELS=

# Optional accounting rates. Keep zero unless you have current contracted/model pricing.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

# Sandbox provider. mock is the safe default until a production adapter is configured.
SANDBOX_PROVIDER=mock
SANDBOX_API_KEY=
