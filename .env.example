# Optional: real LLM gateway. Without these, SkillHydra runs in deterministic demo mode.
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
AI_MODEL=

# Optional: PostgreSQL persistence. The demo works without a database.
DATABASE_URL=postgresql://skillhydra:skillhydra@localhost:5432/skillhydra

# Optional future sandbox provider configuration.
SANDBOX_PROVIDER=mock
SANDBOX_API_KEY=
