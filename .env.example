# PostgreSQL durability. Without this, local development uses the in-memory store.
DATABASE_URL=postgresql://skillhydra:skillhydra@localhost:5432/skillhydra

# Auth boundary.
SKILLHYDRA_AUTH_MODE=dev
SKILLHYDRA_DEV_USER_ID=00000000-0000-4000-8000-000000000001
SKILLHYDRA_ALLOW_DEV_AUTH=false

# AI Gateway. If credentials or AI_MODEL are absent, deterministic demo mode is used.
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
AI_MODEL=
AI_FALLBACK_MODELS=
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

# Execution plane.
# mock = deterministic no-op tools.
# docker = disposable Docker container for shell work plus a temporary copied workspace.
SANDBOX_PROVIDER=mock
SANDBOX_SOURCE_DIR=
SANDBOX_DOCKER_IMAGE=node:22-bookworm-slim
SANDBOX_COMMAND_TIMEOUT_MS=120000
# Docker shell network is disabled by default. Enabling this gives the whole container bridge access;
# use only in trusted environments until the host-scoped egress proxy lands.
SANDBOX_UNSAFE_ALLOW_NETWORK=false
